{
  "sourceLanguage": "en",
  "strings": {
    "Add to shopping list": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zur Einkaufsliste hinzufügen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir a la lista de la compra"
          }
        }
      }
    },
    "Next planned meals": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nächste geplante Mahlzeiten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Próximas comidas planeadas"
          }
        }
      }
    },
    "Open a planned meal": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geplante Mahlzeit öffnen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir una comida planeada"
          }
        }
      }
    },
    "Open shopping list": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einkaufsliste öffnen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir la lista de la compra"
          }
        }
      }
    },
    "Open meal plan": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Essensplan öffnen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir el plan de comidas"
          }
        }
      }
    },
    "Puts an item on your group's shopping list. An amount and a unit are picked up too, e.g. \"2 litres of milk\".": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt einen Eintrag auf die Einkaufsliste eurer Gruppe. Menge und Einheit werden mit erkannt, z. B. „2 Liter Milch“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un artículo a la lista de la compra de tu grupo. También reconoce la cantidad y la unidad, p. ej. «2 litros de leche»."
          }
        }
      }
    },
    "Reads out the meals planned for the coming days.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest die für die nächsten Tage geplanten Mahlzeiten vor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee las comidas planeadas para los próximos días."
          }
        }
      }
    },
    "Opens the recipe for a planned meal.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet das Rezept einer geplanten Mahlzeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la receta de una comida planeada."
          }
        }
      }
    },
    "Shows your group's shopping list.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt die Einkaufsliste eurer Gruppe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra la lista de la compra de tu grupo."
          }
        }
      }
    },
    "Shows your recipes and the days ahead.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt eure Rezepte und die kommenden Tage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra tus recetas y los próximos días."
          }
        }
      }
    },
