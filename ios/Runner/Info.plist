<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>AppGroupId</key>
		<string>group.de.equirinya.coupleplanner</string>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Together Planner</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>coupleplanner</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<!-- Spoken synonyms for the app name. Apple requires every App Shortcut
		     phrase to contain the \(.applicationName) token, and that token
		     expands to any name listed here as well as to CFBundleDisplayName.
		     So the phrase template "Add something to my \(.applicationName)"
		     matches "add something to my shopping list" — the natural phrasing —
		     without breaking the rule. See PlannerShortcuts in AppDelegate.swift
		     for the templates these pair with, and AppShortcuts.xcstrings for
		     the German and Spanish versions of those templates.

		     All three are the same synonym in the three supported languages,
		     rather than three different concepts. That is deliberate: synonyms
		     are app-wide and every phrase template is expanded against every
		     name, so a second *concept* (e.g. "Meal Plan") would let
		     "add something to my meal plan" reach the shopping-list intent.
		     Same word in another language can't misroute, because the German
		     and Spanish phrase templates that pair with it mean the same thing.

		     NOTE: Apple caps this array at three entries — it is now full. A
		     fourth language needs one of these dropped, or the synonym approach
		     abandoned in favour of app-name-only phrases for that language.

		     Localizing via InfoPlist.strings placeholders is the documented
		     alternative and would free slots, but it fails open: a missing key
		     registers the literal placeholder as a synonym rather than nothing.
		     Listing the real words is blunter and cannot silently break. -->
		<key>INAlternativeAppNames</key>
		<array>
			<dict>
				<key>INAlternativeAppName</key>
				<string>Shopping List</string>
				<key>INAlternativeAppNamePronunciationHint</key>
				<string>shopping list</string>
			</dict>
			<dict>
				<key>INAlternativeAppName</key>
				<string>Einkaufsliste</string>
				<key>INAlternativeAppNamePronunciationHint</key>
				<string>ein kaufs liste</string>
			</dict>
			<dict>
				<key>INAlternativeAppName</key>
				<string>Lista de la compra</string>
				<key>INAlternativeAppNamePronunciationHint</key>
				<string>lista de la compra</string>
			</dict>
		</array>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>Together Planner uses your photos to generate a recipe from them.</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UIStatusBarHidden</key>
		<false/>
		<key>UIBackgroundModes</key>
		<array>
			<string>remote-notification</string>
		</array>
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLName</key>
				<string>coupleplanner.invite</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>coupleplanner</string>
				</array>
			</dict>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLName</key>
				<string>coupleplanner.sharemedia</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>ShareMedia-$(PRODUCT_BUNDLE_IDENTIFIER)</string>
				</array>
			</dict>
		</array>
	</dict>
</plist>
